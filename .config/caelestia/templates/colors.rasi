/* Generated by caelestia from the current wallpaper. Do not edit. */
* {
    bg:        #{{ surface.hex }}cc;
    bg-solid:  #{{ surface.hex }};
    bg-alt:    #{{ surfaceContainerHigh.hex }}aa;
    fg:        #{{ onSurface.hex }};
    fg-dim:    #{{ onSurfaceVariant.hex }};
    accent:    #{{ primary.hex }};
    on-accent: #{{ onPrimary.hex }};
    accent2:   #{{ tertiary.hex }};
    sel:       #{{ secondaryContainer.hex }};
    on-sel:    #{{ onSecondaryContainer.hex }};
    border:    #{{ outlineVariant.hex }};
    urgent:    #{{ error.hex }};
}
