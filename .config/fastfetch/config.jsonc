{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "builtin",
    "source": "arch_small",
    "padding": {
      "top": 1,
      "left": 2,
      "right": 3
    },
    "color": {
      "1": "magenta"
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "magenta",
      "title": "blue"
    },
    "key": {
      "width": 10
    }
  },
  "modules": [
    "break",
    {
      "type": "title",
      "format": "{user-name}@{host-name}",
      "color": {
        "user": "magenta",
        "host": "blue"
      }
    },
    {
      "type": "custom",
      "format": "────────────────────────────",
      "outputColor": "90"
    },
    {
      "type": "os",
      "key": "  os"
    },
    {
      "type": "kernel",
      "key": "  kernel"
    },
    {
      "type": "wm",
      "key": "  wm"
    },
    {
      "type": "packages",
      "key": "󰏖  pkgs"
    },
    {
      "type": "shell",
      "key": "  shell"
    },
    {
      "type": "terminal",
      "key": "  term"
    },
    {
      "type": "uptime",
      "key": "󰥔  uptime"
    },
    {
      "type": "memory",
      "key": "󰍛  memory"
    },
    {
      "type": "battery",
      "key": "󰁹  battery"
    },
    {
      "type": "custom",
      "format": "────────────────────────────",
      "outputColor": "90"
    },
    {
      "type": "colors",
      "symbol": "circle",
      "paddingLeft": 2
    },
    "break"
  ]
}