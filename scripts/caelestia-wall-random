#!/usr/bin/env bash
# ==============================================================================
# caelestia-wall-random
# Random wallpaper switcher for Caelestia Shell and Hyprland
# Reads wallpapers directly from ~/Pictures/Wallpapers (or custom folder)
# ==============================================================================

WALLPAPERS_DIR="${CAELESTIA_WALLPAPERS_DIR:-${HOME}/Pictures/Wallpapers}"
TIMER_NAME="caelestia-wallpaper-random.timer"
SERVICE_NAME="caelestia-wallpaper-random.service"

# Supported image extensions (case-insensitive)
VALID_EXTENSIONS='.*\.\(jpg\|jpeg\|png\|webp\|gif\|tif\|tiff\)$'

get_all_wallpapers() {
    local target_dir="${1:-$WALLPAPERS_DIR}"
    if [ ! -d "$target_dir" ]; then
        return 0
    fi
    find "$target_dir" -type f -regex "$VALID_EXTENSIONS" | sort
}

switch_random() {
    local target_dir="${1:-$WALLPAPERS_DIR}"
    
    # Read all valid images into an array
    local -a walls=()
    while IFS= read -r file; do
        [ -n "$file" ] && walls+=("$file")
    done < <(get_all_wallpapers "$target_dir")

    local count=${#walls[@]}

    if [ "$count" -eq 0 ]; then
        echo "⚠️  No wallpapers found in: ${target_dir}"
        echo "    Download some images (.png, .jpg, .webp, .gif) to ${target_dir} to start switching!"
        return 1
    fi

    local current
    current="$(caelestia wallpaper 2>/dev/null || cat ~/.local/state/caelestia/wallpaper/path.txt 2>/dev/null || echo "")"

    if [ "$count" -eq 1 ]; then
        echo "ℹ️  Only 1 wallpaper in ${target_dir}: $(basename "${walls[0]}")"
        echo "    Add more images to enable random switching between them."
        caelestia wallpaper -f "${walls[0]}" >/dev/null 2>&1 || true
        return 0
    fi

    # Filter out current wallpaper so we switch to a different one
    local -a eligible=()
    for w in "${walls[@]}"; do
        if [ "$w" != "$current" ]; then
            eligible+=("$w")
        fi
    done

    # Fallback if somehow empty
    if [ ${#eligible[@]} -eq 0 ]; then
        eligible=("${walls[@]}")
    fi

    # Pick a random one
    local selected="${eligible[RANDOM % ${#eligible[@]}]}"

    # Apply wallpaper
    caelestia wallpaper -f "$selected" >/dev/null 2>&1 || {
        caelestia wallpaper -r -n >/dev/null 2>&1 || true
    }

    local new_current
    new_current="$(caelestia wallpaper 2>/dev/null || cat ~/.local/state/caelestia/wallpaper/path.txt 2>/dev/null || echo "$selected")"
    local name
    name="$(basename "$new_current")"

    if command -v notify-send >/dev/null 2>&1; then
        notify-send -a "caelestia" -i "$new_current" "Wallpaper Switched" "Active theme: ${name}" 2>/dev/null || true
    fi

    echo "✓ Switched to wallpaper: ${name} (${new_current})"
}

run_auto_loop() {
    local interval="${1:-30m}"
    echo "Starting random wallpaper switcher loop (interval: ${interval})..."
    echo "Watching folder: ${WALLPAPERS_DIR}"
    echo "Press Ctrl+C to stop."
    
    # Switch once immediately
    switch_random

    while true; do
        sleep "$interval"
        switch_random
    done
}

enable_timer() {
    local interval="${1:-30m}"
    echo "Configuring systemd user timer with interval ${interval}..."
    
    mkdir -p ~/.config/systemd/user
    cat <<EOF > ~/.config/systemd/user/${TIMER_NAME}
[Unit]
Description=Switch Caelestia wallpaper randomly on interval
PartOf=${SERVICE_NAME}

[Timer]
OnUnitActiveSec=${interval}
OnBootSec=2m
Persistent=true

[Install]
WantedBy=timers.target
EOF

    systemctl --user daemon-reload 2>/dev/null || true
    systemctl --user enable --now "${TIMER_NAME}" 2>/dev/null && echo "Timer ${TIMER_NAME} enabled and active!" || {
        echo "Note: In your active desktop session, run:"
        echo "  systemctl --user daemon-reload"
        echo "  systemctl --user enable --now ${TIMER_NAME}"
    }
}

disable_timer() {
    echo "Disabling systemd user timer..."
    systemctl --user disable --now "${TIMER_NAME}" 2>/dev/null || true
    echo "Timer ${TIMER_NAME} disabled."
}

show_status() {
    local current
    current="$(caelestia wallpaper 2>/dev/null || cat ~/.local/state/caelestia/wallpaper/path.txt 2>/dev/null || echo "None")"
    local count
    count="$(get_all_wallpapers | wc -l)"

    echo "=========================================="
    echo " Caelestia Wallpaper Switcher Status"
    echo "=========================================="
    echo "Wallpapers Folder: ${WALLPAPERS_DIR}"
    echo "Total Wallpapers:  ${count}"
    echo "Current Wallpaper: $(basename "$current")"
    echo "Full Path:         $current"
    echo ""
    echo "Systemd Timer:"
    systemctl --user status "${TIMER_NAME}" 2>/dev/null || echo "  (Not active or not connected to user session)"
    echo "=========================================="
}

list_wallpapers() {
    echo "Wallpapers in ${WALLPAPERS_DIR}:"
    local current
    current="$(caelestia wallpaper 2>/dev/null || cat ~/.local/state/caelestia/wallpaper/path.txt 2>/dev/null || echo "")"

    local -a walls=()
    while IFS= read -r file; do
        [ -n "$file" ] && walls+=("$file")
    done < <(get_all_wallpapers)

    if [ ${#walls[@]} -eq 0 ]; then
        echo "  (No images found. Download images to ${WALLPAPERS_DIR})"
        return 0
    fi

    for img in "${walls[@]}"; do
        local b
        b="$(basename "$img")"
        local rel="${img#${WALLPAPERS_DIR}/}"
        local size
        size="$(du -h "$img" 2>/dev/null | cut -f1)"

        if [ "$img" = "$current" ]; then
            printf "  * %-30s [%4s] (ACTIVE)\n" "$rel" "$size"
        else
            printf "    %-30s [%4s]\n" "$rel" "$size"
        fi
    done
}

set_specific() {
    local target="$1"
    if [ -z "$target" ]; then
        echo "Usage: caelestia-wall-random set <filename_or_path>"
        return 1
    fi

    local file=""
    if [ -f "${WALLPAPERS_DIR}/${target}" ]; then
        file="${WALLPAPERS_DIR}/${target}"
    elif [ -f "$target" ]; then
        file="$(realpath "$target")"
    else
        echo "File not found: ${target}"
        return 1
    fi

    caelestia wallpaper -f "$file" >/dev/null 2>&1
    echo "✓ Set active wallpaper: $(basename "$file")"
}

show_help() {
    cat <<EOF
caelestia-wall-random - Switch wallpapers in random order

Folder: ${WALLPAPERS_DIR}

Usage:
  caelestia-wall-random [COMMAND] [ARGS]

Commands:
  next, -r, (no args)   Switch immediately to a different random wallpaper
  set <filename>        Set a specific wallpaper from the folder
  list                  List all wallpapers currently in the folder
  status                Show active wallpaper and folder info
  auto [INTERVAL]       Run auto-switch daemon loop in terminal (default: 30m, e.g. 10m, 1h)
  enable [INTERVAL]     Enable & start systemd background timer (default: 30m)
  disable               Stop & disable systemd background timer
  help, -h, --help      Show this help message

Quick Shortcuts:
  Super + Shift + W     Built-in Hyprland keybind to switch wallpaper
  wall                  Terminal alias to switch wallpaper
  wall-random           Alias for caelestia-wall-random
EOF
}

case "${1:-next}" in
    next|-r)
        switch_random
        ;;
    set)
        shift
        set_specific "$@"
        ;;
    list)
        list_wallpapers
        ;;
    status)
        show_status
        ;;
    auto)
        shift
        run_auto_loop "$@"
        ;;
    enable)
        shift
        enable_timer "$@"
        ;;
    disable)
        disable_timer
        ;;
    help|-h|--help)
        show_help
        ;;
    *)
        if [ -f "${WALLPAPERS_DIR}/$1" ] || [ -f "$1" ]; then
            set_specific "$1"
        else
            echo "Unknown command: $1"
            show_help
            exit 1
        fi
        ;;
esac
